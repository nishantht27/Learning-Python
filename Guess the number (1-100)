import random

b = random.randint(1,100)
while True :
    a = int(input('Guess the number between 1 to 100'))
    print('\n',a)
    if a == b :
        print('Congratulations_You_Won')
        break    
    elif a>b :
        print('Too_High')
    elif a<b:
        print('Too_Low')
    else:
        print('Guess_a_valid_Number')